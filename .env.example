# Copy to `.env` (kept out of git) and fill in keys only for the providers you
# intend to run. The harness reads this file from the repository root.
#
# Each model in run_editing.py's REGISTRY names the key it needs; you only need
# keys for the models you actually evaluate.

# OpenAI — GPT-5.x via the Responses API. OPENAI_API_KEY2 is tried first, then
# OPENAI_API_KEY, so you can keep a separate key for these runs.
OPENAI_API_KEY=
OPENAI_API_KEY2=

# Anthropic — Claude Sonnet / Opus (native Messages API)
ANTHROPIC_API_KEY=

# Google — Gemini via the OpenAI-compatible endpoint
GEMINI_API_KEY=

# OpenRouter — DeepSeek, GLM, MiniMax, Qwen, Gemma, Kimi, etc.
OPENROUTER_API_KEY=

# OpenTyphoon — Typhoon 2.5 (api.opentyphoon.ai). Distinct from the gateway key.
TYPHOON_API_KEY=

# ThaiLLM national gateway (thaillm.or.th) — OpenThaiGPT / Typhoon-S / THaLLE
THAILLM_API_KEY=
